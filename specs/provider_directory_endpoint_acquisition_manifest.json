    "entry_support": {
      "iowa-medicaid": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public CMS-listed R4 endpoint exposes all eight Plan-Net collections. Acquisition uses stable _id sorting, synthetic _skip pagination, one-request-per-second pacing, and durable checkpoints. Resource population and publication readiness require separate verification."},
      "pennsylvania-medicaid": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public CMS-listed R4 endpoint exposes all eight Plan-Net collections. Acquisition uses stable _id sorting, synthetic _skip pagination, one-request-per-second pacing, and durable checkpoints. Resource population and publication readiness require separate verification."},
      "san-bernardino-county-dbh": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public Netsmart R4 endpoint exposes all eight resource families. Its advertised next offset overlaps the preceding page, so acquisition ignores that link and advances a stable _id-sorted _offset by the exact Bundle entry count."},
      "san-mateo-county-bhrs": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public Netsmart R4 endpoint exposes all eight resource families. Its advertised next offset overlaps the preceding page, so acquisition ignores that link and advances a stable _id-sorted _offset by the exact Bundle entry count."},
      "el-dorado-county-behavioral-health": {"support_level": "probe-only", "access_requirement": "registration-approval", "requires_registration": true, "reviewed_at": "2026-08-26", "method": "probe", "documented_resources": ["InsurancePlan", "PractitionerRole", "Practitioner", "Organization", "Location", "HealthcareService", "OrganizationAffiliation", "Endpoint"], "limitation": "The county documents organization registration and approval for /provider/system-access/v2. The older /payer/provider-directory/v2 endpoint does not establish access or source equivalence for that contract. Acquisition requires approved access and complete exhaustive proof."},
      "devoted-health": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public R4 endpoint exposes seven configured Plan-Net collections and same-origin opaque HAPI continuations. Acquisition retains durable checkpoints and requires exhaustive completion before publication."},
      "simpra-advantage": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The public R4 endpoint exposes six configured Plan-Net collections and same-origin opaque HAPI continuations. Acquisition retains durable checkpoints and requires exhaustive completion before publication."},
      "capital-blue-cross": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "documented_resources": ["InsurancePlan", "PractitionerRole", "Practitioner", "Organization", "Location", "HealthcareService", "OrganizationAffiliation", "Endpoint"], "limitation": "Broad exact census requests require a search predicate. Ranged counts do not establish endpoint completeness when ge0001, _lastUpdated:missing, and _id:missing predicates are unsupported and no history or bulk-export operation is advertised. Acquisition remains probe-only."},
      "idaho": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Accepts official public cursor continuations with checkpoints."},
      "molina": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Acquisition retains durable pagination checkpoints and fails closed with pagination_resume_required when a complete traversal cannot resume. Terminal endpoint-wide proof and downstream publication require separate verification."},
      "michigan": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-09-03", "method": "rest", "limitation": "Acquisition is configured for Location, Organization, OrganizationAffiliation, Practitioner, and PractitionerRole using exact advertised cursor replay and durable checkpoints. Synthetic _getpagesoffset continuation is not equivalent and remains prohibited. Configured acquisition does not establish publication or serving readiness."},
      "cigna": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Sequential REST pagination preserves Plan-Net network extensions and supports configured _count=100 and _count=75 searches. No Bulk/export operation is advertised. Expected nonempty initial searches retry transient HTTP-200 empty search sets with cooldowns."},
      "caresource": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Collections use same-origin opaque _page/_searchId continuations. Full-refresh acquisition durably records a pre-scan _summary=count census, checkpoints every opaque next link without the generic page ceiling, and permits terminal completion only when processed and unique candidate resource IDs equal unchanged post-scan census. Any cursor loss, duplicate/count mismatch, or census drift fails closed. No product membership is inferred from the catalog row."},
      "aetna-commercial-medicare": {"support_level": "acquisition-configured", "access_requirement": "oauth2-client-credentials", "requires_registration": true, "reviewed_at": "2026-08-26", "method": "bulk", "limitation": "OAuth2 client credentials and Bulk; Endpoint collection is unavailable. Credentialed transport aliases do not establish another carrier directory."},
      "humana": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Uses the carrier-wide public FHIR base; catalog product aliases are neutralized and plan/network provenance comes from FHIR resources."},
      "iehp": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Normalizes portal and resource paths to the official public Provider Directory base. Collection access and continuation behavior require separate verification because metadata may omit configured HealthcareService and InsurancePlan resources."},
      "arkansas": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Uses synthetic _skip pagination with stable _id sorting. Resource population is dataset-specific; terminal acquisition and current artifact plus unified/API readiness require separate verification."},
      "hap": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Rewrites the blocked cursor host and throttles requests to 20 seconds. Acquisition validates each rewritten continuation for the configured collections."},
      "washington": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "Acquisition fails closed with provider_directory_pagination_resume_required when HealthcareService or PractitionerRole cannot resume. A catalog entry does not establish authoritative totals, stable exhaustive cursors, or a reproducible complete pass."},
      "wyoming": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Uses standard _count=100 pagination; PractitionerRole pagination requires complete traversal proof."},
      "health-partners-plans": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Uses the official public Provider Directory FHIR base. Terminal acquisition proof, current dataset publication, and downstream artifact/API readiness are separate requirements."},
      "amerihealth-caritas-carrier": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "One carrier-level A6 directory is acquired solely from the public 0900 transport. The acquisition row clears plan_name and does not claim NH product membership. Exhaustive equivalence with plan-code bases is not established, so no resource evidence is fanned out and no product membership is inferred for plan-code aliases. Terminal six-collection acquisition evidence and downstream readiness require separate verification."},
      "amerihealth-de": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The plan-code base remains probe-only because exhaustive equivalence with the carrier transport is not established. No duplicate full acquisition, acquired rows, or product membership is inferred for this alias."},
      "amerihealth-la": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The plan-code base remains probe-only because exhaustive equivalence with the carrier transport is not established. No duplicate full acquisition, acquired rows, or product membership is inferred for this alias."},
      "amerihealth-nc": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The plan-code base remains probe-only because exhaustive equivalence with the carrier transport is not established. No duplicate full acquisition, acquired rows, or product membership is inferred for this alias."},
      "amerihealth-dc": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The plan-code base remains probe-only because exhaustive equivalence with the carrier transport is not established. No duplicate full acquisition, acquired rows, or product membership is inferred for this alias."},
      "amerihealth-pa": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The plan-code base remains probe-only because exhaustive equivalence with the carrier transport is not established. No duplicate full acquisition, acquired rows, or product membership is inferred for this alias."},
      "horizon-nj": {"support_level": "probe-only", "access_requirement": "oauth2-client-credentials", "requires_registration": true, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "The configured base exposes public R4 metadata with no declared resources, while core searches return HAPI HTTP 403 Access denied by rule. Horizon documents developer registration, an approved Provider Directory API-product subscription, subscription credentials, and OAuth2 client credentials; no authenticated pageable production endpoint has been verified."},
      "texas-tmhp": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Seven configured public collections use stable _id sorting and offset pagination; Endpoint is excluded. Terminal acquisition proof and downstream publication readiness require separate verification."},
      "nebraska": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Seven configured public collections use stable _id sorting and offset pagination. Endpoint returns HTTP 404 and remains excluded; UAT continuation is canonicalized before acquisition. Terminal acquisition proof and downstream readiness require separate verification."},
      "uhc": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "documented_resources": ["InsurancePlan", "PractitionerRole", "Practitioner", "Organization", "Location", "HealthcareService", "OrganizationAffiliation", "Endpoint"], "limitation": "UnitedHealthcare documents anonymous public directory access at /fhirpublic and /fhirpublic2025. HealthcareService requires service-category=prov. Broad collections clamp totals at 10,000; plan-network and state partitions do not establish exhaustive coverage. Missing meta.lastUpdated and an ignored :missing modifier prevent a proven disjoint residual. Generic resource acquisition remains blocked, and plan_graph_complete never satisfies endpoint publication. The distinct uhc-provider-files source is the maintained exhaustive transport and does not change this FHIR endpoint's probe-only status."},
      "uhc-provider-files": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "official-files", "limitation": "The corporate official-file source runs as an atomic source group inside the normal Provider Directory importer. It refreshes and pins the complete reviewed catalog, concurrently downloads missing files under a hard bound, verifies retained bytes, builds sealed semantic facts with bounded file-level and range-level parallelism, materializes six canonical resource families, and publishes only after exact content proof succeeds. Downstream unified/API readiness requires separate verification."},
      "cms-npd": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-09-29", "method": "bulk", "limitation": "The eight official FHIR bulk files are admitted as one source-local immutable candidate only after the complete release validates. Publication requires a second exact vector and retained-byte check. Downstream profile and API readiness require separate verification."},
      "missouri": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "Metadata declares eight directory resources, but Location returns false-empty Bundles above _count=100, Bundle.total reflects only the page size, a Practitioner response exceeds the 20 MiB cap, and HealthcareService and PractitionerRole requests time out. Other resource searches also return contradictory empty Bundles; no stable exhaustive REST or Bulk Data acquisition contract is verified."},
      "maine": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Five collections are anonymously readable with ct cursor pagination. InsurancePlan, HealthcareService, and Endpoint return HTTP 403 and remain excluded. Terminal acquisition and current artifact plus unified/API readiness require separate verification."},
      "scan": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "documented_resources": ["InsurancePlan", "PractitionerRole", "Practitioner", "Organization", "Location", "HealthcareService", "OrganizationAffiliation", "Endpoint"], "limitation": "The 1,000-result search ceiling is handled with pageable <=1,000-row _lastUpdated leaves. Candidate acquisition uses adaptive half-open _lastUpdated partitions with a one-second minimum leaf width, stable _lastUpdated,_id sorting, pre/post unfiltered and ranged census reconciliation, durable retry checkpoints, full-payload fingerprints, and staged-row proof. SCAN remains probe-only and non-runnable until one full all-resource campaign produces terminal completeness metrics."},
      "centene": {"support_level": "probe-only", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "probe", "limitation": "Location requires at least one resource search parameter: an _count-only request is unsupported. Generic resource acquisition is blocked because stable exhaustive pagination and equivalent behavior across all directory collections remain unverified."},
      "contra-costa": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "Seven public collections follow opaque next-link pagination; Endpoint is unsupported and excluded. The official catalog can return HTTP 403, so the configured fallback base is retained. Current artifact and unified/API readiness require separate verification."},
      "alohr": {"support_level": "acquisition-configured", "access_requirement": "private-connector", "requires_registration": true, "reviewed_at": "2026-08-26", "method": "graphql", "limitation": "FHIR REST reads are auth-gated; the maintained connector uses GraphQL. The source does not expose organization-affiliation relationships. A fresh four-resource GraphQL acquisition must validate before artifact publication, and unified/API readiness requires separate proof."},
      "kaiser": {"support_level": "acquisition-configured", "access_requirement": "none", "requires_registration": false, "reviewed_at": "2026-08-26", "method": "rest", "limitation": "The reviewed public R4 source remains manual-only and excluded from automatic scheduling. Its server-issued traversal subset requires replay and reviewed one-root activation evidence. The root-neutral subset proof records advertised, returned, and deficit counts; documented terminal-window bounds remain applicable, and absence under the subset remains unknown. Downstream unified/API runtime verification requires separate proof."}
