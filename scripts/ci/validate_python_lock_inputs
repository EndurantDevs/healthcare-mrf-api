#!/usr/bin/env python3
"""Fail when the exact Python lock no longer matches its recursive inputs."""

from __future__ import annotations

import hashlib
from pathlib import Path
import re
import sys


repository_root = (
    Path(sys.argv[1]).resolve()
    if len(sys.argv) == 2
    else Path(__file__).resolve().parents[2]
)
input_names = ("requirements.txt", "requirements-dev.txt", "requirements-ci.in")
lock_text = (repository_root / "requirements-ci.lock").read_text(encoding="utf-8")
recorded = dict(
    re.findall(r"^# Input: ([^ ]+) \(([0-9a-f]{64})\)$", lock_text, re.MULTILINE)
)
expected = {
    name: hashlib.sha256((repository_root / name).read_bytes()).hexdigest()
    for name in input_names
}
if recorded != expected:
    raise SystemExit(
        "requirements-ci.lock does not match its recursive inputs; "
        "regenerate it with scripts/ci/compile_python_lock"
    )
