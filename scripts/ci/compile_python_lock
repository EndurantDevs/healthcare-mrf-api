#!/usr/bin/env bash
set -euo pipefail

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
arc_image='ghcr.io/endurantdevs/healthcare-mrf-api-arc-ci@sha256:0e97164f0e06b60fe5608e5654e026a88c3ef5d3b6a195a26fdc60489b404803'

if [ "$(docker info --format '{{.OSType}}/{{.Architecture}}')" != linux/x86_64 ]; then
  echo "Python lock generation requires a native Linux/amd64 Docker engine" >&2
  exit 2
fi

docker run --rm --interactive --platform linux/amd64 \
  --user "$(id -u):$(id -g)" \
  --volume "$repository_root:/workspace" \
  --workdir /workspace \
  --env HOME=/tmp \
  --env "ARC_IMAGE=$arc_image" \
  "$arc_image" \
  bash -s <<'CONTAINER'
set -euo pipefail
test "$(python -c 'import platform; print(platform.python_version())')" = 3.14.6
test "$(python -c 'import platform; print(platform.machine())')" = x86_64
test "$(python -m pip --version | awk '{print $2}')" = 26.1.2
temporary_directory=$(mktemp -d)
candidate_lock=$(mktemp requirements-ci.lock.candidate.XXXXXX)
trap 'rm -rf -- "$temporary_directory"; rm -f -- "$candidate_lock"' EXIT
input_names=(requirements.txt requirements-dev.txt requirements-ci.in)
mkdir "$temporary_directory/inputs"
sha256sum "${input_names[@]}" > "$temporary_directory/input-sha256.before"
cp -- "${input_names[@]}" "$temporary_directory/inputs/"
(
  cd "$temporary_directory/inputs"
  sha256sum "${input_names[@]}"
) > "$temporary_directory/input-sha256.snapshot"
cmp "$temporary_directory/input-sha256.before" "$temporary_directory/input-sha256.snapshot"
python -m pip install \
  --dry-run \
  --ignore-installed \
  --only-binary=:all: \
  --report "$temporary_directory/selected.json" \
  -r "$temporary_directory/inputs/requirements-ci.in"
python - \
  "$temporary_directory/selected.json" \
  "$temporary_directory/inputs" \
  "$candidate_lock" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import sys
from urllib.parse import urlparse


report_path = Path(sys.argv[1])
input_root = Path(sys.argv[2])
output_path = Path(sys.argv[3])
report = json.loads(report_path.read_text(encoding="utf-8"))
environment = report.get("environment", {})
expected_environment = {
    "implementation_name": "cpython",
    "implementation_version": "3.14.6",
    "platform_machine": "x86_64",
    "platform_system": "Linux",
    "python_full_version": "3.14.6",
    "sys_platform": "linux",
}
for field, expected in expected_environment.items():
    if environment.get(field) != expected:
        raise SystemExit(
            f"pip report {field}={environment.get(field)!r}; expected {expected!r}"
        )

requirements = {}
for item in report.get("install", []):
    metadata = item.get("metadata", {})
    name = re.sub(r"[-_.]+", "-", str(metadata.get("name", ""))).lower()
    version = str(metadata.get("version", ""))
    download = item.get("download_info", {})
    artifact = Path(urlparse(str(download.get("url", ""))).path).name
    digest = download.get("archive_info", {}).get("hashes", {}).get("sha256")
    if not name or not version or not artifact.endswith(".whl"):
        raise SystemExit(f"non-wheel or malformed selected artifact: {item!r}")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise SystemExit(f"missing SHA256 for selected artifact: {artifact}")
    if name in requirements:
        raise SystemExit(f"duplicate selected distribution: {name}")
    requirements[name] = (version, digest)

if not requirements or requirements.get("pip", (None,))[0] != "26.2.1":
    raise SystemExit("selected lock must contain pip==26.2.1")
if requirements.get("pip-audit", (None,))[0] != "2.10.1":
    raise SystemExit("selected lock must contain pip-audit==2.10.1")

lines = [
    "# Generated by scripts/ci/compile_python_lock.",
    *(
        f"# Input: {name} ({hashlib.sha256((input_root / name).read_bytes()).hexdigest()})"
        for name in ("requirements.txt", "requirements-dev.txt", "requirements-ci.in")
    ),
    f"# ARC image: {os.environ['ARC_IMAGE']}",
    f"# Python: {platform.python_version()} ({platform.system()} {platform.machine()})",
    "# Resolver: pip 26.1.2",
    "# Each hash is the wheel selected on native Linux/amd64 by pip's install report.",
    "--only-binary :all:",
    "",
]
lines.extend(
    f"{name}=={version} --hash=sha256:{digest}"
    for name, (version, digest) in sorted(requirements.items())
)
output_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
python -m pip install \
  --dry-run \
  --ignore-installed \
  --only-binary=:all: \
  --require-hashes \
  -r "$candidate_lock"
sha256sum "${input_names[@]}" > "$temporary_directory/input-sha256.after"
if ! cmp -s \
  "$temporary_directory/input-sha256.before" \
  "$temporary_directory/input-sha256.after"; then
  echo "Python requirement inputs changed during lock generation" >&2
  exit 1
fi
mv -- "$candidate_lock" requirements-ci.lock
sha256sum requirements-ci.lock
CONTAINER
