arc_image='ghcr.io/endurantdevs/healthcare-mrf-api-arc-ci@sha256:12320cf489cc218f00d04e9df21d12f60bacd883e5120bd8dabb7ba0378c972c'
postgres_image='postgis/postgis:18-3.6@sha256:0aacdfb9dda40942d424785c3ccabeffe31da9cc9e26b0dfd93b222b31462871'
redis_image='redis:7@sha256:e9b2e45ecd47fbb69b877cf8d045d5cccaaaed52524b6e098b4abe8212994f73'
semgrep_image='returntocorp/semgrep-agent@sha256:50140e658095736c7f9d2c12c1e8a98b13f044b773dc79aa98e83b8117dbf096'
container_rust_image='docker.io/library/rust:1.97.1-slim-trixie@sha256:fc0648ac2962539be80bd424729a20fd80f7b64bfba7e90bbd642aed6c697c5a'
container_python_image='docker.io/library/python:3.14.6-slim-trixie@sha256:b921fe7e7522f828d45197a47656ec465a9b15689b27fa8e1fba2864fca5b967'

capacity_test_paths=${CAPACITY_TEST_PATHS:-$'tests/test_ptg2_capacity_evidence.py\ntests/test_ptg2_v3_bounded_readers.py\ntests/test_ptg2_v3_capacity_gate.py\ntests/test_ptg2_v3_capacity_gate_adversarial.py\ntests/test_ptg2_v3_capacity_resources.py'}
artifact_root=${PREPUSH_ARTIFACT_ROOT:-.}

artifact_path() {
  if [ "$artifact_root" = . ]; then
    printf '%s\n' "$1"
  else
    printf '%s/%s\n' "${artifact_root%/}" "$1"
  fi
}

usage() {
  cat >&2 <<'EOF'
usage: scripts/ci/prepush MODE [ARG]

MODE is one of:
  all BASE_SHA
  hygiene
  quality
  python-main 0|1|2|3
  capacity
  python-coverage
  api-contract
  rust
  container-package
  security
  redis
  postgres core|provider-directory|provider-profile
EOF
  exit 2
}

prepare_python_environment() {
  if [ "${PREPUSH_DEPS_READY:-0}" = 1 ]; then
    return
  fi
  if [ "${PREPUSH_PYTHON_ENV_READY:-0}" = 1 ]; then
    return
  fi
  python_environment_root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-prepush-python.XXXXXX")
  python -m venv "$python_environment_root/venv"
  export VIRTUAL_ENV="$python_environment_root/venv"
  export PATH="$VIRTUAL_ENV/bin:$PATH"
  unset PYTHONHOME || true
  export PREPUSH_PYTHON_ENV_READY=1
  cleanup_python_environment() {
    rm -rf -- "$python_environment_root"
  }
  trap cleanup_python_environment EXIT
}

install_python_dependencies() {
  if [ "${PREPUSH_DEPS_READY:-0}" = 1 ]; then
    return
  fi
  prepare_python_environment
  scripts/ci/install_python_lock
}

require_base_sha() {
  if [[ ! "${COVERAGE_BASE_SHA:-}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "COVERAGE_BASE_SHA must be an exact commit SHA" >&2
    exit 2
  fi
}

commit_message_policy() {
  if [ "${GITHUB_EVENT_NAME:-}" = pull_request ]; then
    python3 scripts/check_commit_messages.py --event "$GITHUB_EVENT_PATH"
  else
    require_base_sha
    python3 scripts/check_commit_messages.py --range "$COVERAGE_BASE_SHA..HEAD"
  fi
}

run_hygiene() {
  commit_message_policy
  python3 tests/test_public_hygiene.py
  python3 scripts/ci/public_hygiene.py
}

run_quality() {
  commit_message_policy
  install_python_dependencies
  python -m compileall api process db public_evidence scripts main.py
  python scripts/smoke/provider_directory_runtime_contract.py
  python scripts/generate_provider_directory_support_docs.py --check
  bash tests/test_ci_readability_policy.sh

  if [ -n "${BASE_SHA:-}" ]; then
    git show "$BASE_SHA:readability-baseline.json" > "${RUNNER_TEMP:-/tmp}/readability-base.json"
    required_reduction_percent=1
    if git diff --quiet "$BASE_SHA" HEAD -- \
      main.py \
      ':(glob)api/**/*.py' \
      ':(glob)db/**/*.py' \
      ':(glob)process/**/*.py' \
      ':(glob)public_evidence/**/*.py' \
      ':(glob)service/**/*.py'; then
      required_reduction_percent=0
    elif [ "${READABILITY_ZERO_GROWTH_APPROVED:-false}" = true ]; then
      required_reduction_percent=0
    fi
    python scripts/readability_budget.py \
      --ratchet-baseline "${RUNNER_TEMP:-/tmp}/readability-base.json" \
      --required-reduction-percent "$required_reduction_percent"
  else
    python scripts/readability_budget.py
  fi

  python scripts/ci/request_time_external_call_guard.py
  timeout --foreground 295s python -m pytest -q \
    tests/test_coverage_forecast.py \
    tests/test_ci_coverage_forecast.py \
    tests/test_ci_prepush_contract.py
}

run_python_main() {
  local shard=${1:-}
  case "$shard" in 0|1|2|3) ;; *) usage ;; esac
  if [ "${PREPUSH_DEPS_READY:-0}" = 1 ]; then
    cargo build --locked --bins --manifest-path support/ptg2_scanner/Cargo.toml
  else
    prepare_python_environment
    install_python_dependencies &
    local pip_pid=$!
    cargo build --locked --bins --manifest-path support/ptg2_scanner/Cargo.toml &
    local cargo_pid=$!
    wait "$pip_pid"
    wait "$cargo_pid"
  fi

  mapfile -t capacity_tests <<< "$capacity_test_paths"
  local collection_args=()
  local test_path
  for test_path in "${capacity_tests[@]}"; do
    collection_args+=(--ignore "$test_path")
  done
  local shard_file="${RUNNER_TEMP:-/tmp}/python-test-shard-${shard}.txt"
  python scripts/ci/shard_pytest_nodeids.py \
    --shard-count 4 \
    --shard-index "$shard" \
    --output "$shard_file" \
    -- "${collection_args[@]}"
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path ".coverage.main.${shard}")}
  timeout --foreground 295s python -m pytest -q -n 1 --dist loadscope --durations=20 \
    --cov-config=test-coverage.ini \
    --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main \
    --cov-branch --cov-report= \
    @"$shard_file"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind main \
    --shard "$shard" \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path ".coverage-provenance.main.${shard}.json")"
}

run_capacity() {
  install_python_dependencies
  mapfile -t capacity_tests <<< "$capacity_test_paths"
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path .coverage.capacity)}
  timeout --foreground 295s python -m pytest -q -n 4 --dist load --durations=20 \
    --cov-config=test-coverage.ini \
    --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main \
    --cov-branch --cov-report= \
    "${capacity_tests[@]}"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind capacity \
    --shard capacity \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path .coverage-provenance.capacity.json)"
}

run_python_coverage() {
  install_python_dependencies
  require_base_sha
  timeout --foreground 295s python scripts/coverage_ratchet.py --self-test
  timeout --foreground 295s python scripts/coverage_forecast.py forecast-python \
    --base "$COVERAGE_BASE_SHA" \
    --main-artifacts "${PREPUSH_MAIN_ARTIFACTS:-coverage-data/main}" \
    --capacity-artifacts "${PREPUSH_CAPACITY_ARTIFACTS:-coverage-data/capacity}" \
    --postgres-artifacts "${PREPUSH_POSTGRES_ARTIFACTS:-coverage-data/postgres}" \
