run_rust() {
  local rust_artifacts
  rust_artifacts=$(artifact_path coverage-artifacts/rust)
  install_python_dependencies
  cargo fmt --manifest-path support/ptg2_scanner/Cargo.toml -- --check
  cargo clippy --manifest-path support/ptg2_scanner/Cargo.toml --all-targets -- -D warnings
  mkdir -p "$rust_artifacts"
  cargo install cargo-llvm-cov --version 0.8.7 --locked
  timeout --foreground 295s cargo llvm-cov --manifest-path support/ptg2_scanner/Cargo.toml \
    --all-targets --features python --json --summary-only \
    --output-path "$rust_artifacts/test-coverage-rust.json"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-report-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --report-name rust \
    --report "$rust_artifacts/test-coverage-rust.json" \
    --output "$rust_artifacts/coverage-provenance-rust.json" \
    --cargo-llvm-cov-version "$(cargo llvm-cov --version | awk '{print $2}')" \
    --rust-version "$(rustc --version | awk '{print $2}')"
  timeout --foreground 295s python scripts/coverage_ratchet.py --self-test
  timeout --foreground 295s python scripts/coverage_forecast.py forecast-rust \
    --base "$COVERAGE_BASE_SHA" \
    --artifacts "$rust_artifacts" \
    --output "$(artifact_path test-coverage-forecast-rust.json)"
  require_margin "$(artifact_path test-coverage-forecast-rust.json)" rust functions 2
  cargo install cargo-audit --version 0.22.2 --locked
  (cd support/ptg2_scanner && cargo audit)
  cargo build --release --bins --manifest-path support/ptg2_scanner/Cargo.toml
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_TEST_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
    timeout --foreground 295s python -m pytest -q \
      tests/test_provider_directory_projection_native_copy.py \
      tests/test_provider_directory_projection_native_cli_parity.py \
      tests/test_provider_directory_projection_native_copy_adversarial.py
  (
    local wheel_directory
    wheel_directory=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-ptg2-wheel.XXXXXX")
    trap 'rm -rf -- "$wheel_directory"' EXIT
    cd support/ptg2_scanner
    python -m maturin build --release --features python-extension --out "$wheel_directory"
    shopt -s nullglob
    local wheels=("$wheel_directory"/*.whl)
    [ "${#wheels[@]}" -eq 1 ]
    if [ "$artifact_root" != . ]; then
      printf '%s  %s\n' \
        "$(sha256sum "${wheels[0]}" | awk '{print $1}')" \
        "$(basename "${wheels[0]}")" \
        > "$(artifact_path ptg2-address-canon-wheel.sha256)"
    fi
    python -m pip install --no-deps "${wheels[0]}"
    python -m pip check
  )
  timeout --foreground 295s python -m pytest -q tests/test_address_canon_pyo3.py
  (
    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf -- "$tmp"' EXIT
    support/ptg2_scanner/target/release/ptg2_scanner --canon-version \
      | python -c 'import json,sys; payload=json.load(sys.stdin); assert payload["ruleset_version"] == 4, payload'
    printf "1\t(0,1)\t\\N\t123 Main St\tSuite 2\tAustin\tTX\t78701\tUS\n" > "$tmp/raw.copy"
    support/ptg2_scanner/target/release/ptg2_scanner \
      --address-canonicalize-copy "$tmp/raw.copy" "$tmp/keyed.copy"
    test -s "$tmp/keyed.copy"
  )
}

run_container_package() {
  local source_commit=${GITHUB_SHA:-$(git rev-parse HEAD)}
  local image=${PREPUSH_CONTAINER_IMAGE:-healthcare-mrf-api:ptg-v4-gate}
  docker build \
    --platform linux/amd64 \
    --build-arg "HLTHPRT_SOURCE_COMMIT=${source_commit}" \
    --tag "$image" \
    .
  if docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' \
    "$image" \
    | grep -q '^HLTHPRT_SOURCE_COMMIT='; then
    exit 1
  fi
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$image" \
    -ec '
      test "$(cat /opt/healthporta/build-identity/healthcare-source-commit)" = "$1"
      test "$(stat -c "%u:%g:%a:%h:%s" /opt/healthporta/build-identity/healthcare-source-commit)" = "0:0:444:1:41"
    ' sh "$source_commit"
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$image" \
    -ec '
      test -x /opt/support/ptg2_scanner/target/release/ptg2_scanner
      test -x /opt/support/ptg2_scanner/target/release/ptg2_provider_graph_v4
      /opt/venv/bin/python -c "import ptg2_address_canon as m; assert hasattr(m, '\''intersect_sorted_u32'\''); assert hasattr(m, '\''ptg2_decode_u32_le'\'')"
      /opt/venv/bin/python -B -c "import public_evidence; import process.npi"
