  alembic upgrade head
}

drop_test_database() {
  PGPASSWORD="$HLTHPRT_DB_PASSWORD" dropdb --if-exists \
    --host "$HLTHPRT_DB_HOST" \
    --port "$HLTHPRT_DB_PORT" \
    --username "$HLTHPRT_DB_USER" \
    "$1"
}

create_test_database() {
  local database=$1
  drop_test_database "$database"
  PGPASSWORD="$HLTHPRT_DB_PASSWORD" createdb \
    --host "$HLTHPRT_DB_HOST" \
    --port "$HLTHPRT_DB_PORT" \
    --username "$HLTHPRT_DB_USER" \
    "$database"
}

