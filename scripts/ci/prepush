run_postgres() {
  local shard=${1:-}
  case "$shard" in core|provider-directory|provider-profile) ;; *) usage ;; esac
  if [ "${PREPUSH_DEPS_READY:-0}" = 1 ]; then
    cargo build --manifest-path support/ptg2_scanner/Cargo.toml
  else
    prepare_python_environment
    install_python_dependencies &
    local pip_pid=$!
    cargo build --manifest-path support/ptg2_scanner/Cargo.toml &
    local cargo_pid=$!
    wait "$pip_pid"
    wait "$cargo_pid"
  fi

  export HLTHPRT_DB_DRIVER=${HLTHPRT_DB_DRIVER:-asyncpg}
  export HLTHPRT_DB_HOST=${HLTHPRT_DB_HOST:-127.0.0.1}
  export HLTHPRT_DB_PORT=${HLTHPRT_DB_PORT:-5432}
  export HLTHPRT_DB_USER=${HLTHPRT_DB_USER:-postgres}
  export HLTHPRT_DB_PASSWORD=${HLTHPRT_DB_PASSWORD:-postgres}
  export HLTHPRT_DB_DATABASE=${HLTHPRT_DB_DATABASE:-ptg2_v3_lifecycle_test_ci_runner}
  export HLTHPRT_DB_SCHEMA=${HLTHPRT_DB_SCHEMA:-mrf}
  export DB_SCHEMA=${DB_SCHEMA:-mrf}
  export HLTHPRT_REDIS_ADDRESS=${HLTHPRT_REDIS_ADDRESS:-redis://127.0.0.1:6379}
  export PYTEST_ADDOPTS=${PYTEST_ADDOPTS:-'--cov-config=test-coverage.ini --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main --cov-branch --cov-report= --cov-append'}
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path ".coverage.postgres.${shard}")}

  prepare_postgres
  local dsn="postgresql://${HLTHPRT_DB_USER}:${HLTHPRT_DB_PASSWORD}@${HLTHPRT_DB_HOST}:${HLTHPRT_DB_PORT}/${HLTHPRT_DB_DATABASE}"
  case "$shard" in
    core) run_core_postgres "$dsn" ;;
    provider-directory) run_provider_directory_postgres "$dsn" ;;
    provider-profile) run_provider_profile_postgres "$dsn" ;;
  esac

  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind postgres \
    --shard "$shard" \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path ".coverage-provenance.postgres.${shard}.json")"
}

assert_candidate_unchanged() {
  local candidate_sha=$1
  if [ "$(git rev-parse HEAD)" != "$candidate_sha" ] \
    || ! git diff --quiet \
    || ! git diff --cached --quiet \
    || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "candidate changed while the pre-push gate was running" >&2
    exit 1
  fi
}

require_margin() {
  local forecast=$1
  local report=$2
  local metric=$3
  local minimum=$4
  python3 - "$forecast" "$report" "$metric" "$minimum" <<'PY'
import json
import sys
from pathlib import Path


forecast_path, report, metric, minimum_text = sys.argv[1:]
payload = json.loads(Path(forecast_path).read_text(encoding="utf-8"))
margin = payload["reports"][report]["metrics"][metric]["margin"]
minimum = int(minimum_text)
if not isinstance(margin, int) or isinstance(margin, bool) or margin < minimum:
    raise SystemExit(
        f"{report} {metric} coverage margin is {margin}; pre-push requires at least {minimum}"
    )
PY
}

run_all() {
  local base_sha=${1:-}
  if [[ ! "$base_sha" =~ ^[0-9a-f]{40}$ ]]; then
    echo "all requires an exact 40-character BASE_SHA" >&2
    usage
  fi
  git cat-file -e "${base_sha}^{commit}"
  command -v docker >/dev/null

  local candidate_sha
  candidate_sha=$(git rev-parse HEAD)
  if ! git diff --quiet || ! git diff --cached --quiet \
    || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "all requires a clean, committed candidate" >&2
    exit 2
  fi
  if ! git merge-base --is-ancestor "$base_sha" "$candidate_sha"; then
    echo "BASE_SHA must be an ancestor of the candidate" >&2
    exit 2
  fi

  local suffix=${BASHPID:-$$}
  network="healthcare-prepush-${suffix}"
  postgres_container="healthcare-prepush-postgres-${suffix}"
  redis_container="healthcare-prepush-redis-${suffix}"
  local container_image="healthcare-mrf-api:prepush-${candidate_sha:0:12}-${suffix}"
  artifacts=${PREPUSH_RECEIPT_DIR:-}
  local git_common_dir
  local python_lock_input_sha256
  local python_lock_sha256
  local readability_zero_growth_approved=${READABILITY_ZERO_GROWTH_APPROVED:-false}
  python_lock_input_sha256=$(sha256sum requirements-ci.in | awk '{print $1}')
  python_lock_sha256=$(sha256sum requirements-ci.lock | awk '{print $1}')
  if [ -z "$artifacts" ]; then
    artifacts=$(mktemp -d "${TMPDIR:-/tmp}/healthcare-prepush-receipt.XXXXXX")
  else
    mkdir -p "$artifacts"
    artifacts=$(cd "$artifacts" && pwd)
    if [[ "$artifacts/" == "$repository_root/"* ]]; then
      echo "PREPUSH_RECEIPT_DIR must be outside the repository" >&2
      exit 2
    fi
    if [ -n "$(find "$artifacts" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
      echo "PREPUSH_RECEIPT_DIR must be empty" >&2
      exit 2
    fi
  fi
  git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
  printf 'pre-push receipt: %s\n' "$artifacts"
  cat > "$artifacts/receipt.txt" <<EOF
status=running
candidate_sha=$candidate_sha
base_sha=$base_sha
arc_image=$arc_image
postgres_image=$postgres_image
redis_image=$redis_image
semgrep_image=$semgrep_image
container_image_tag=$container_image
container_rust_image=$container_rust_image
container_python_image=$container_python_image
python_version=3.14.6
python_lock_input_sha256=$python_lock_input_sha256
python_lock_sha256=$python_lock_sha256
pip_version=26.1.2
rust_toolchain=1.97.1
cargo_llvm_cov_version=0.8.7
cargo_audit_version=0.22.2
pip_audit_version=2.10.1
python_coverage_version=7.15.4
python_line_margin_minimum=5
python_branch_margin_minimum=5
rust_function_margin_minimum=2
readability_zero_growth_approved=$readability_zero_growth_approved
command=scripts/ci/prepush all $base_sha
EOF
  cleanup_all() {
    local cleanup_status=$?
    docker rm --force "$postgres_container" "$redis_container" >/dev/null 2>&1 || true
    docker network rm "$network" >/dev/null 2>&1 || true
    if [ "$cleanup_status" -ne 0 ]; then
      printf 'status=failed\n' >> "$artifacts/receipt.txt"
    fi
    return "$cleanup_status"
  }
  trap cleanup_all EXIT

  if [ "$(docker info --format '{{.OSType}}/{{.Architecture}}')" != linux/x86_64 ]; then
    echo "all requires a native Linux/amd64 Docker engine; emulation is not accepted" >&2
    exit 2
  fi

  docker network create "$network" >/dev/null
  docker run --detach --rm --platform linux/amd64 \
    --name "$postgres_container" \
    --network "$network" \
    --network-alias postgres \
    --env POSTGRES_PASSWORD=postgres \
    --env POSTGRES_DB=ptg2_v3_lifecycle_test_ci_runner \
    "$postgres_image" >/dev/null
  docker run --detach --rm --platform linux/amd64 \
    --name "$redis_container" \
    --network "$network" \
    --network-alias redis \
    "$redis_image" >/dev/null

  local ready=0
  local attempt
  for attempt in {1..60}; do
    if docker exec "$postgres_container" \
      pg_isready -U postgres -d ptg2_v3_lifecycle_test_ci_runner >/dev/null 2>&1 \
      && docker exec "$redis_container" redis-cli ping 2>/dev/null | grep -qx PONG; then
      ready=1
      break
    fi
    sleep 1
  done
  if [ "$ready" != 1 ]; then
    echo "pinned PostgreSQL and Redis services did not become ready" >&2
    exit 1
  fi

  docker run --rm --platform linux/amd64 \
    --user "$(id -u):$(id -g)" \
    --network "$network" \
    --volume "$repository_root:/workspace" \
    --volume "$git_common_dir:$git_common_dir" \
    --volume "$artifacts:/artifacts" \
    --workdir /workspace \
    --env COVERAGE_BASE_SHA="$base_sha" \
    --env BASE_SHA="$base_sha" \
    --env GITHUB_EVENT_NAME=push \
    --env GITHUB_SHA="$candidate_sha" \
    --env PREPUSH_ARTIFACT_ROOT=/artifacts \
    --env PREPUSH_MAIN_ARTIFACTS=/artifacts/coverage-data/main \
    --env PREPUSH_CAPACITY_ARTIFACTS=/artifacts/coverage-data/capacity \
    --env PREPUSH_POSTGRES_ARTIFACTS=/artifacts/coverage-data/postgres \
    --env PREPUSH_PIP_REPORT=/artifacts/python-lock-install-report.json \
    --env READABILITY_ZERO_GROWTH_APPROVED="$readability_zero_growth_approved" \
    "$arc_image" \
    bash -lc '
      set -euo pipefail
      export HOME=/artifacts/home
      export CARGO_HOME=/tmp/cargo
      export RUSTUP_HOME=/tmp/rustup
      export PATH=/tmp/venv/bin:/tmp/cargo/bin:/usr/local/cargo/bin:$PATH
      mkdir -p "$HOME" "$CARGO_HOME" "$RUSTUP_HOME" /artifacts/coverage-data/{main,capacity,postgres}
      cp -R /usr/local/rustup/. "$RUSTUP_HOME/"
      python -m venv /tmp/venv
      scripts/ci/install_python_lock
      python -m pip freeze --all > /artifacts/python-locked-versions.txt
      rustup component add rustfmt clippy llvm-tools-preview
      git config --global --add safe.directory /workspace
      export PREPUSH_DEPS_READY=1

      gate() {
        local name=$1
        shift
        scripts/ci/prepush "$@"
        if [ "$(git rev-parse HEAD)" != "$GITHUB_SHA" ] \
          || ! git diff --quiet \
          || ! git diff --cached --quiet \
          || [ -n "$(git ls-files --others --exclude-standard)" ]; then
          echo "candidate changed during gate: $name" >&2
          exit 1
        fi
        printf "gate=%s passed\n" "$name" >> /artifacts/receipt.txt
      }

      gate hygiene hygiene
      gate quality quality
      for shard in 0 1 2 3; do
        gate "python-main-$shard" python-main "$shard"
        cp "/artifacts/.coverage.main.${shard}" "/artifacts/.coverage-provenance.main.${shard}.json" /artifacts/coverage-data/main/
      done
      gate capacity capacity
      cp /artifacts/.coverage.capacity /artifacts/.coverage-provenance.capacity.json /artifacts/coverage-data/capacity/
      gate api-contract api-contract
      HLTHPRT_REDIS_ADDRESS=redis://redis:6379 gate redis redis
      PREPUSH_SKIP_SEMGREP=1 gate security-audit security
      for shard in core provider-directory provider-profile; do
        PGPASSWORD=postgres dropdb --if-exists --host postgres --port 5432 --username postgres ptg2_v3_lifecycle_test_ci_runner
        PGPASSWORD=postgres createdb --host postgres --port 5432 --username postgres ptg2_v3_lifecycle_test_ci_runner
        HLTHPRT_DB_DRIVER=asyncpg \
        HLTHPRT_DB_HOST=postgres \
        HLTHPRT_DB_PORT=5432 \
        HLTHPRT_DB_USER=postgres \
        HLTHPRT_DB_PASSWORD=postgres \
        HLTHPRT_DB_DATABASE=ptg2_v3_lifecycle_test_ci_runner \
        HLTHPRT_DB_SCHEMA=mrf \
        DB_SCHEMA=mrf \
        HLTHPRT_REDIS_ADDRESS=redis://127.0.0.1:6379 \
          gate "postgres-$shard" postgres "$shard"
        cp "/artifacts/.coverage.postgres.${shard}" "/artifacts/.coverage-provenance.postgres.${shard}.json" /artifacts/coverage-data/postgres/
      done
      gate python-coverage python-coverage
      gate rust rust
      {
        python --version
        python -m pip --version
        python -c '"'"'import platform, sys; print(f"python_cache_tag={sys.implementation.cache_tag}"); print(f"platform={platform.platform()}"); print(f"machine={platform.machine()}"); print(f"libc={platform.libc_ver()}")'"'"'
        cargo --version
        rustc --version
        cargo llvm-cov --version
        cargo audit --version
        psql --version
        python -m coverage --version
        pip-audit --version
        PGPASSWORD=postgres psql --host postgres --port 5432 --username postgres --dbname ptg2_v3_lifecycle_test_ci_runner --tuples-only --no-align --command "show server_version"
        PGPASSWORD=postgres psql --host postgres --port 5432 --username postgres --dbname ptg2_v3_lifecycle_test_ci_runner --tuples-only --no-align --command "select postgis_full_version()"
        python - <<PY
import asyncio
from redis.asyncio import Redis


async def main() -> None:
    redis = Redis.from_url("redis://redis:6379", decode_responses=True)
    info = await redis.info(section="server")
    print("redis " + info["redis_version"])
    await redis.aclose()


asyncio.run(main())
PY
      } > /artifacts/tool-versions.txt
      sha256sum requirements.txt requirements-dev.txt requirements-ci.in requirements-ci.lock scripts/ci/install_python_lock support/ptg2_scanner/Cargo.lock test-coverage-baseline.json > /artifacts/input-sha256.txt
    '

  PREPUSH_SKIP_AUDIT=1 GITHUB_EVENT_NAME=push GITHUB_SHA="$candidate_sha" run_security
  assert_candidate_unchanged "$candidate_sha"
  printf 'gate=security-semgrep passed\n' >> "$artifacts/receipt.txt"
  PREPUSH_CONTAINER_IMAGE="$container_image" GITHUB_SHA="$candidate_sha" run_container_package
  assert_candidate_unchanged "$candidate_sha"
  printf 'gate=container-package passed\n' >> "$artifacts/receipt.txt"
  local container_image_id
  container_image_id=$(docker image inspect --format '{{.Id}}' "$container_image")
  printf '%s\n' "$container_image_id" > "$artifacts/container-image-id.txt"
  docker version > "$artifacts/docker-version.txt"
  cat >> "$artifacts/receipt.txt" <<EOF
status=passed
completed_at_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
python_forecast=$artifacts/test-coverage-forecast-python.json
rust_forecast=$artifacts/test-coverage-forecast-rust.json
python_locked_versions=$artifacts/python-locked-versions.txt
python_locked_versions_sha256=$(sha256sum "$artifacts/python-locked-versions.txt" | awk '{print $1}')
python_install_report=$artifacts/python-lock-install-report.json
python_install_report_sha256=$(sha256sum "$artifacts/python-lock-install-report.json" | awk '{print $1}')
ptg2_wheel_evidence=$artifacts/ptg2-address-canon-wheel.sha256
ptg2_wheel_sha256=$(awk '{print $1}' "$artifacts/ptg2-address-canon-wheel.sha256")
container_image_id=$container_image_id
container_image_id_evidence=$artifacts/container-image-id.txt
EOF
  cleanup_all
  trap - EXIT
}

case "${1:-}" in
  all) [ "$#" -eq 2 ] || usage; run_all "$2" ;;
  hygiene) [ "$#" -eq 1 ] || usage; run_hygiene ;;
  quality) [ "$#" -eq 1 ] || usage; run_quality ;;
  python-main) [ "$#" -eq 2 ] || usage; run_python_main "$2" ;;
  capacity) [ "$#" -eq 1 ] || usage; run_capacity ;;
  python-coverage) [ "$#" -eq 1 ] || usage; run_python_coverage ;;
  api-contract) [ "$#" -eq 1 ] || usage; run_api_contract ;;
  rust) [ "$#" -eq 1 ] || usage; run_rust ;;
  container-package) [ "$#" -eq 1 ] || usage; run_container_package ;;
  security) [ "$#" -eq 1 ] || usage; run_security ;;
  redis) [ "$#" -eq 1 ] || usage; run_redis ;;
  postgres) [ "$#" -eq 2 ] || usage; run_postgres "$2" ;;
  *) usage ;;
esac
