        /opt/venv/bin/python -B \
        /opt/scripts/smoke/provider_directory_terminal_root_retirement.py \
        2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      test "$operation_output" = '\''{"code":"disabled","status":"error"}'\''
    '
}

run_security() {
  if [ "${PREPUSH_SKIP_AUDIT:-0}" != 1 ]; then
    install_python_dependencies
    python -m pip_audit --disable-pip --require-hashes -r requirements-ci.lock
  fi
  if [ "${PREPUSH_SKIP_SEMGREP:-0}" != 1 ]; then
    local security_git_common_dir
    security_git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
    local event_args=(--env GITHUB_EVENT_PATH)
    if [ -f "${GITHUB_EVENT_PATH:-}" ]; then
      event_args=(
        --volume "$GITHUB_EVENT_PATH:/github/event.json:ro"
        --env GITHUB_EVENT_PATH=/github/event.json
      )
    fi
    docker run --rm --platform linux/amd64 \
      --user "$(id -u):$(id -g)" \
      --volume "$repository_root:/src" \
      --volume "$security_git_common_dir:$security_git_common_dir" \
      --workdir /src \
      --env HOME=/tmp \
      --env GITHUB_ACTIONS \
      --env GITHUB_API_URL \
      --env GITHUB_SERVER_URL \
      --env GITHUB_REPOSITORY \
      --env GITHUB_REF \
      --env GITHUB_HEAD_REF \
      --env GITHUB_BASE_REF \
      --env GITHUB_RUN_ID \
      --env GITHUB_TOKEN \
      --env INPUT_CONFIG=.semgrep.yml \
      --env GITHUB_WORKSPACE=/src \
      --env GITHUB_EVENT_NAME="${GITHUB_EVENT_NAME:-push}" \
      --env GITHUB_SHA="${GITHUB_SHA:-$(git rev-parse HEAD)}" \
      "${event_args[@]}" \
      "$semgrep_image"
  fi
}

run_redis() {
  install_python_dependencies
  python - <<'PY'
import asyncio
import os
from urllib.parse import urlparse

from redis.asyncio import Redis


async def main() -> None:
    address = urlparse(os.environ.get("HLTHPRT_REDIS_ADDRESS", "redis://127.0.0.1:6379"))
    redis = Redis(
        host=address.hostname or "127.0.0.1",
        port=address.port or 6379,
        decode_responses=True,
    )
    await redis.rpush("arq:ci-smoke", "healthporta-ci")
    assert await redis.llen("arq:ci-smoke") == 1
    await redis.delete("arq:ci-smoke")
    await redis.aclose()


asyncio.run(main())
PY
  timeout --foreground 295s python -m pytest -q \
    tests/test_control_workers.py \
    tests/test_control_imports_api.py \
    tests/test_control_cancel.py
}

prepare_postgres() {
  python - <<'PY'
import asyncio
import os

import asyncpg


async def main() -> None:
    conn = await asyncpg.connect(
        host=os.environ["HLTHPRT_DB_HOST"],
        port=int(os.environ["HLTHPRT_DB_PORT"]),
