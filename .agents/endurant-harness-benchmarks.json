          "HLTHPRT_DB_POOL_MAX_SIZE": "32",
          "HLTHPRT_DB_POOL_MIN_SIZE": "1",
          "HLTHPRT_DB_PORT": "5432",
          "HLTHPRT_DB_SCHEMA": "mrf",
          "HLTHPRT_DB_USER": "postgres",
          "HLTHPRT_ENTITY_ADDRESS_ALIAS_BENCHMARK_ROWS": "10000",
          "PYTHONDONTWRITEBYTECODE": "1"
